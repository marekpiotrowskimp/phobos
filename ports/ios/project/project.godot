; Engine configuration file.
config_version=5

[application]

config/name="PHOBOS"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

general/ios/session_category=0

[autoload]

Balance="*res://scripts/autoloads/balance.gd"
GameState="*res://scripts/autoloads/game_state.gd"
AudioLib="*res://scripts/autoloads/audio_lib.gd"
InputSetup="*res://scripts/autoloads/input_setup.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.015, 0.015, 0.035, 1)
textures/vram_compression/import_etc2_astc=true
